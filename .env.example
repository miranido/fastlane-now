# Copy to .env.local and fill in. Every value here is also needed in Vercel.

# --- Web Push (VAPID) -------------------------------------------------------
# Generate a pair with:  node scripts/generate-vapid.mjs
# Changing these invalidates every existing push subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Supabase ---------------------------------------------------------------
# Project settings → API. The service role key bypasses RLS: server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Scheduler --------------------------------------------------------------
# Shared secret between pg_cron and /api/cron/tick.
# Generate with:  openssl rand -hex 32
CRON_SECRET=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Price relay (Cloudflare Worker) -----------------------------------------
# fastlane.co.il's Cloudflare returns 403 to cloud providers, so production
# fetches through workers/price-proxy. Leave both unset locally to call the
# endpoint directly (works from an ordinary Israeli connection).
PRICE_PROXY_URL=
PRICE_PROXY_SECRET=

# --- Telegram (optional; delivery is implemented, linking flow is not) ------
TELEGRAM_BOT_TOKEN=
